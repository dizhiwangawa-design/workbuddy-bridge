{
  "name": "workbuddy-bridge",
  "version": "0.4.0",
  "description": "WorkBuddy 多账号桥接：MCP 子 Agent、Anthropic Messages、OpenAI Chat/Responses 与共享号池",
  "type": "module",
  "license": "MIT",
  "bin": {
    "workbuddy-bridge": "bin/wb.js",
    "wb": "bin/wb.js"
  },
  "main": "src/server.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dizhiwangawa-design/workbuddy-bridge.git"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node bin/wb.js serve",
    "login": "node bin/wb.js login",
    "install-agents": "node bin/wb.js install",
    "doctor": "node bin/wb.js doctor",
    "test": "node test/run.mjs && node test/api/run.mjs",
    "test:api": "node test/api/run.mjs",
    "test:live": "node test/live/anthropic-live.mjs",
    "test:live:openai": "node test/live/openai-live.mjs",
    "test:live:responses": "node test/live/responses-live.mjs",
    "test:live:account": "node test/live/account-smoke.mjs",
    "test:live:codex": "node test/live/codex-client-smoke.mjs",
    "test:load": "node test/load/slow-reader.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "qrcode": "^1.5.4"
  },
  "keywords": [
    "mcp",
    "workbuddy",
    "anthropic",
    "openai",
    "responses",
    "api",
    "codebuddy",
    "claude-code",
    "cursor",
    "codex",
    "opencode"
  ],
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "openai": "^7.53.0",
    "ws": "^8.22.1"
  }
}
